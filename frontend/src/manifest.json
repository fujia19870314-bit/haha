{
  "name": " mourning-diary",
  "appid": "__UNI__MOURNINGDIARY",
  "description": "AI 哀伤引导日记",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {},
    "distribute": {
      "android": {
        "permissions": ["<uses-permission android:name=\"android.permission.INTERNET\" />"]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "touristappid",
    "usingComponents": true,
    "permission": {
      "scope.userLocation": {
        "desc": "用于展示本地危机干预资源"
      }
    },
    "requiredBackgroundModes": [],
    "lazyCodeLoading": "requiredComponents",
    "optimization": {
      "subPackages": true
    },
    "setting": {
      "urlCheck": false,
      "es6": true,
      "enhance": true,
      "postcss": true,
      "minified": true,
      "bigPackageSizeSupport": true
    }
  },
  "mp-alipay": {},
  "mp-baidu": {},
  "mp-toutiao": {},
  "uniStatistics": {
    "enable": false
  },
  "vueVersion": "3"
}
